{
  "name": "tsukuyomi",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsup",
    "dev": "ts-node-dev --respawn --transpile-only --require tsconfig-paths/register --env-file=.env src/server.ts",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/shared/infrastructure/config/database.ts",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/shared/infrastructure/config/database.ts",
    "format": "prettier --write .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint:deps": "depcruise --config .dependency-cruiser.js src"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "client-s3": "github:aws-sdk/client-s3",
    "discord.js": "^14.24.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "sharp": "^0.34.5",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "typeorm": "0.3.27"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "pino-pretty": "^13.1.2"
  }
}
